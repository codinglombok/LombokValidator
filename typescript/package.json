{
  "name": "lombokvalidator",
  "version": "0.1.0",
  "description": "Zero-dependency input validation (string, number, schema, custom rules, sanitization) with i18n-ready errors. Byte-identical with the Rust reference.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "require": "./dist/cjs/index.js"
    }
  },
  "files": [
    "dist/src",
    "dist/cjs",
    "README.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "validation",
    "validator",
    "sanitize",
    "input",
    "schema",
    "i18n"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/codinglombok/LombokValidator.git",
    "directory": "typescript"
  },
  "scripts": {
    "build:esm": "tsc -p tsconfig.json",
    "build:cjs": "tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({ type: 'commonjs' }, null, 2) + '\\n')\"",
    "build": "npm run build:esm && npm run build:cjs",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build:esm && node --test \"dist/test/*.test.js\"",
    "coverage": "npm run build && c8 npm run test:only",
    "test:only": "node --test \"dist/test/*.test.js\""
  },
  "c8": {
    "include": ["dist/src/**/*.js"],
    "all": true,
    "reporter": ["text", "lcov"],
    "check-coverage": true,
    "statements": 95,
    "branches": 90,
    "functions": 95,
    "lines": 95
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "@types/node": "^22.0.0",
    "c8": "^10.1.3"
  },
  "peerDependencies": {
    "lomboklocale": "^0.1.0"
  },
  "peerDependenciesMeta": {
    "lomboklocale": {
      "optional": true
    }
  }
}
